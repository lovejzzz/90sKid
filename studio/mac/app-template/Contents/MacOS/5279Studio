#!/bin/bash
# 5279 Studio — macOS launcher.
#
# Rules that make a loop impossible:
#   * Terminal is opened at most ONCE, and only when no Python environment
#     exists yet.  The setup script writes a "setup-done" marker.
#   * If an environment (or the marker) exists, the launcher never opens
#     Terminal again: it starts the engine directly and, if the engine dies
#     within its first seconds, shows the error in a dialog and stops.

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
APP="$(cd "$HERE/../.." && pwd)"
RES="$APP/Contents/Resources"
STUDIO="$RES/studio"
if [ ! -f "$STUDIO/app.py" ]; then
  # Running from the repository clone: studio/mac/app-template/Contents/MacOS
  STUDIO="$(cd "$HERE/../../../.." && pwd)"
fi

SUPPORT="$HOME/Library/Application Support/5279 Studio"
VENV="$SUPPORT/venv"
LOG="$HOME/Library/Logs/5279Studio.log"
DONE="$SUPPORT/setup-done"
mkdir -p "$SUPPORT" "$(dirname "$LOG")"
export FILM5279_CACHE="$SUPPORT/cache"
export FILM5279_WORK="$HOME/Movies/5279 Studio"
export PYTHONUNBUFFERED=1

dialog() {  # dialog "message" "button1" ["button2"] -> prints chosen button
  local msg="$1" b1="$2" b2="${3:-}"
  local buttons="{\"$b1\"}"
  [ -n "$b2" ] && buttons="{\"$b1\", \"$b2\"}"
  msg="$(printf '%s' "$msg" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  osascript -e "display dialog \"$msg\" buttons $buttons default button 1 with title \"5279 Studio\"" 2>/dev/null | sed 's/button returned://'
}

find_python() {
  local candidates=(
    /opt/homebrew/bin/python3 /usr/local/bin/python3
    /Library/Frameworks/Python.framework/Versions/3.13/bin/python3
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3
    /Library/Frameworks/Python.framework/Versions/3.11/bin/python3
    /Library/Frameworks/Python.framework/Versions/3.10/bin/python3
  )
  local found
  found="$(command -v python3 2>/dev/null || true)"
  [ -n "$found" ] && candidates+=("$found")
  for p in "${candidates[@]}"; do
    if [ -x "$p" ] && "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
      echo "$p"; return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------- first run
if [ ! -x "$VENV/bin/python" ] && [ ! -f "$DONE" ]; then
  PY="$(find_python || true)"
  if [ -z "$PY" ]; then
    dialog "5279 Studio 需要 Python 3.10 或更新版本。请先从 python.org 安装 Python，然后再打开 5279 Studio。

5279 Studio needs Python 3.10 or newer. Install it from python.org, then open the app again." "打开 python.org" >/dev/null
    open "https://www.python.org/downloads/macos/"
    exit 1
  fi
  # The marker is written NOW, before Terminal opens, so a second click can
  # never open a second setup window.
  date > "$DONE"
  SETUP="$SUPPORT/setup.command"
  cat > "$SETUP" <<EOF
#!/bin/bash
echo "5279 Studio · 首次安装 / first-time setup"
echo "Python: $PY"
echo
if [ ! -x "$VENV/bin/python" ]; then
  "$PY" -m venv "$VENV" || { echo; echo "✗ 无法创建 Python 环境 / could not create the environment"; exit 1; }
fi
"$VENV/bin/python" -m pip install --upgrade pip >/dev/null 2>&1
"$VENV/bin/python" -m pip install -r "$STUDIO/requirements.txt" || { echo; echo "✗ 依赖安装失败 / dependency install failed (see above)"; exit 1; }
"$VENV/bin/python" -m pip install pywebview || echo "(pywebview 不可用，将改用浏览器窗口 / falling back to the browser)"
echo
echo "检查安装 / verifying…"
"$VENV/bin/python" -c "import numpy, cv2, numba, imageio_ffmpeg; print('ok')" || { echo; echo "✗ 引擎依赖无法导入，请把上面的错误发给开发者 / engine imports failed, please report the error above"; exit 1; }
echo
echo "✓ 安装完成。现在请在“应用程序”里双击 5279 Studio 打开它。首次打开会构建光谱格子，约 3 到 5 分钟，之后即时启动。"
echo "✓ Installed. Now double-click 5279 Studio in Applications. The first start builds the spectral lattices (3–5 min); later starts are instant."
echo
echo "可以关闭这个窗口 / you can close this window."
EOF
  chmod +x "$SETUP"
  open -a Terminal "$SETUP"
  exit 0
fi

# ------------------------------------------------------- environment missing
if [ ! -x "$VENV/bin/python" ]; then
  choice="$(dialog "上次的安装没有完成（没有找到 Python 环境）。要重新安装吗？

The previous setup did not finish (no Python environment found). Run setup again?" "重新安装 / Retry" "取消 / Cancel")"
  if [ "$choice" = "重新安装 / Retry" ]; then
    rm -f "$DONE"
    exec "$0"
  fi
  exit 1
fi

# ------------------------------------------------------------------ launch
cd "$STUDIO"
echo "$(date) launcher: starting $VENV/bin/python app.py --window" >>"$LOG"
"$VENV/bin/python" "$STUDIO/app.py" --window >>"$LOG" 2>&1 &
PID=$!
# If the engine dies within its first seconds, show why and stop.
for _ in 1 2 3 4 5 6 7 8; do
  sleep 1
  if ! kill -0 "$PID" 2>/dev/null; then
    wait "$PID"; CODE=$?
    if [ "$CODE" -ne 0 ]; then
      ERR="$(tail -n 12 "$LOG" 2>/dev/null)"
      choice="$(dialog "5279 Studio 无法启动（退出码 $CODE）。最近的日志：

${ERR:0:900}

完整日志：$LOG" "打开日志 / Open log" "重新安装 / Reinstall")"
      if [ "$choice" = "重新安装 / Reinstall" ]; then
        rm -rf "$VENV" "$DONE"
        exec "$0"
      fi
      open -a Console "$LOG" 2>/dev/null || open "$LOG"
      exit "$CODE"
    fi
    exit 0
  fi
done
wait "$PID"
