# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
__pycache__/
*.pyc

# The engine keeps generated caches and local camera media out of Git. Their
# builders, checksums, measurement reports and lightweight review assets stay
# versioned; full-resolution ProRes/RAW/DPX/EXR/TIFF media does not.
/engine/cache/
/engine/outputs/
/engine/work/
/engine/input_proxy/
/engine/references/*.cube
/engine/references/**/*.cube
/engine/research_runs/2026-08-03_vendor_2383_targets/real_frame12_vendor_ab/*.npz
/engine/**/*.mov
/engine/**/*.mp4
/engine/**/*.mxf
/engine/**/*.dpx
/engine/**/*.exr
/engine/**/*.tif
/engine/**/*.tiff
